{
  "name": "pendulum-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/main.ts --dev",
    "dev:mock": "tsx server/main.ts --dev --mock",
    "dev:serial-sim": "tsx server/main.ts --dev --serial-sim",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serialport": "13.0.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
